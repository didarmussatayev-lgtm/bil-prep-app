# Строка подключения к Postgres. На Railway берётся из переменной DATABASE_URL
# после добавления сервиса Postgres в проект — Railway подставит её сама.
DATABASE_URL="postgresql://user:password@localhost:5432/bil_prep_db"

# Только для scripts/create-admin.ts (создание первого администратора), см. step3-auth-README.
# ADMIN_LOGIN=admin
# ADMIN_PASSWORD=минимум-12-символов

# Срок жизни сессии (8 ч), кука-подпись и т.п. — не через .env, а константы
# в src/lib/auth/config.ts (там же зафиксировано, что менять и зачем).
