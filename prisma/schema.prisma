// Схема базы данных для сайта подготовки к БИЛ
// PostgreSQL, разворачивается на Railway
//
// Собрана из: базового черновика (пункт 1) + prisma/auth-models.prisma (шаг 3)
// + prisma/student-models.prisma (шаг 5, авторитетная версия Progress/TaskResult/TestAttempt)
// + prisma/schema-additions.prisma (шаг 4, только то, что реально используется — slug/order/number).
//
// Test/TestQuestion из черновика НЕ используются: начиная с шага 5 вопросы тестов
// подбираются на лету (см. TestAttempt.questionIds, src/lib/student/tests.ts, TEST_CONFIG).
// Модели оставлены ниже закомментированными на случай, если понадобится редактируемый
// список тестов из админки — раскомментируйте и снова смигрируйте.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Пользователи и сессии (шаг 3) ----------

enum Role {
  student
  admin
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique // хранится в нижнем регистре
  passwordHash String   @map("password_hash")
  role         Role     @default(student)
  createdAt    DateTime @default(now()) @map("created_at")
  // false — ученику открыт весь материал; true — только книги из bookAccess
  restrictAccess Boolean @default(false) @map("restrict_access")

  bookAccess   UserBookAccess[]
  notes        StudentNote[]
  taskAttempts TaskAttempt[]
  loginEvents  LoginEvent[]
  sessions     Session[]
  progress     Progress[]
  taskResults  TaskResult[]
  testAttempts TestAttempt[]
  helpRequests HelpRequest[]

  @@map("users")
}

// «Книга» = пара (предмет, Section.level): Математика 1–4 — level 1–4, Логика — level 1.
// Хранится пара, а не список разделов, поэтому новые разделы книги открываются автоматически.
model UserBookAccess {
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String  @map("subject_id")
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level     Int

  @@id([userId, subjectId, level])
  @@map("user_book_access")
}

// Заметки администратора об ученике (видны только в админке; в PDF для родителей не попадают, если не включить явно).
model StudentNote {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("student_notes")
}

// Журнал успешных входов (сессии живут 8 часов и чистятся, а для выявления «одного пароля на нескольких людей» нужна история).
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  device    String // «Chrome · Android» — по User-Agent
  kicked    Int      @default(0) // сколько ещё действующих сессий этот вход оборвал
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("login_events")
}

model Session {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String   @unique @map("token_hash") // SHA-256 от токена из куки
  expiresAt     DateTime @map("expires_at")
  revoked       Boolean  @default(false)
  revokedReason String?  @map("revoked_reason") // replaced | admin | logout | password_reset
  ip            String?
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId, revoked])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------- Структура контента ----------

model Subject {
  id    String @id @default(cuid())
  name  String @unique // "Математика" | "Логика"
  slug  String @unique // "math" | "logic" — идёт в URL /bil/math (шаг 5)
  order Int    @default(0)

  sections     Section[]
  testAttempts TestAttempt[]
  bookAccess   UserBookAccess[]

  i18n Json? // {kk:{...,reviewed:false}} — переводы; null = только русский

  @@map("subjects")
}

model Section {
  id        String @id @default(cuid())
  subjectId String @map("subject_id")
  title     String // "I раздел. Дроби, проценты и пропорции"
  slug      String @unique // "math-1" (шаг 4, идемпотентный seed)
  order     Int    @default(0)
  level     Int    @default(1) // уровень внутри предмета: для математики 1–4 («Математика 1–4»)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@index([subjectId])
  i18n Json? // {kk:{...,reviewed:false}} — переводы; null = только русский

  @@map("sections")
}

model Topic {
  id                 String @id @default(cuid())
  sectionId          String @map("section_id")
  title              String // "1.1 Дроби"
  slug               String @unique // "math-1.1.1" (шаг 4)
  order              Int    @default(0)
  // ExplanationBlock[] (см. src/lib/content/types.ts) ИЛИ строка Markdown
  // (заголовки ###, **жирный**, :::figure {json}) — обе формы разбирает parseExplanation().
  explanationContent Json?  @map("explanation_content")
  hidden             Boolean @default(false) // скрыта от учеников (быстрое «скрыть» в админке)
  // Кэш числа видимых ученику задач (без «ждущих рисунка»): open → practiceCount, test_choice → testCount.
  // null = ещё не посчитано; пересчёт — lib/student/topic-counts.ts (seed и правки контента в админке).
  practiceCount      Int?   @map("practice_count")
  testCount          Int?   @map("test_count")

  section  Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  tasks    Task[]
  progress Progress[]

  @@index([sectionId])
  i18n Json? // {kk:{...,reviewed:false}} — переводы; null = только русский

  @@map("topics")
}

// ---------- Задачи ----------

enum TaskType {
  test_choice // вопрос теста с вариантами A–E → пул для тестов
  open // задача с открытым ответом → пул для «Закрепить тему»
}

model Task {
  id      String   @id @default(cuid())
  topicId String   @map("topic_id")
  type    TaskType
  hidden  Boolean  @default(false) // скрыта от учеников: не в закреплении, не в тестах
  slug    String?  @unique // "math-1.1.1:p:1a" / "math-1.1.1:t:3" — у задач из админки может быть null
  number  String? // номер как в книге: "1a", "7"
  order   Int      @default(0)

  question String @db.Text

  // Для type = test_choice:
  // options — string[] (положение в массиве = буква A, B, C… — см. parseOptions в lib/content/types.ts)
  options       Json?
  correctOption String? @map("correct_option") // "A".."E"

  // Для type = open:
  answerType        String?  @map("answer_type") // integer | decimal | fraction | mixed
  correctAnswerJson Json?    @map("correct_answer") // {value} | {num,denom} | {whole,num,denom}
  allowUnreduced    Boolean  @default(false) @map("allow_unreduced")

  solutionText String? @db.Text @map("solution_text") // разбор (кнопка «Показать решение», шаг 6)
  // FigureSpec | FigureSpec[] — параметры параметрических SVG (шаг 6); фигуры с kind="placeholder"
  // скрывают задачу от учеников до тех пор, пока рисунок не заменят (см. lib/content/types.ts).
  // Названо c суффиксом Json (не imageParams), чтобы совпадать с полем, которое пишут
  // админка (шаг 7) и seed (шаг 4) — под этим именем поле и ушло в Prisma Client.
  imageParamsJson Json? @map("image_params")

  topic   Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  results TaskResult[]
  helpRequests HelpRequest[]
  attemptsLog  TaskAttempt[]

  @@index([topicId])
  i18n Json? // {kk:{...,reviewed:false}} — переводы; null = только русский

  @@map("tasks")
}

// ---------- Прогресс (шаг 5 — заменяет черновую Progress: status/score → отдельные поля) ----------

model Progress {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId       String    @map("topic_id")
  topic         Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  learnedAt     DateTime? @map("learned_at") // тема отмечена как изученная
  lastAttemptAt DateTime? @map("last_attempt_at")

  @@unique([userId, topicId])
  @@map("progress")
}

// Результат ученика по каждой задаче (пишется на шаге 6 при проверке ответа)
model TaskResult {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId     String   @map("task_id")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  correct    Boolean  @default(false) // хотя бы раз решена верно
  attempts   Int      @default(0)
  lastAnswer Json?    @map("last_answer")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, taskId])
  @@index([userId])
  @@map("task_results")
}

// Журнал попыток в закреплении: каждая проверка ответа — одна строка. TaskResult хранит только итог по паре
// ученик+задача, поэтому периоды в отчётах, график «задач в неделю» и серии дней строятся по этой таблице.
// История ведётся с момента появления таблицы.
model TaskAttempt {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  topicId   String   @map("topic_id") // копия Task.topicId — чтобы считать по темам без join
  correct   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([topicId, createdAt])
  @@map("task_attempts")
}

enum HelpStatus {
  open // ученик не смог решить — ждёт разбора на встрече
  resolved // разобрано (админом или ученик потом решил сам)
}

enum HelpSource {
  practice // закрепление темы
  test // пробный тест (вопрос во время теста или на экране разбора)
}

// Заявка «Не смог решить»: одна на пару ученик+задача (повторная отметка снова открывает её)
model HelpRequest {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId       String     @map("task_id")
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  source       HelpSource @default(practice)
  attemptId    String?    @map("attempt_id") // для source=test: попытка теста
  note         String?    @db.Text // что не получилось (необязательно)
  status       HelpStatus @default(open)
  autoResolved Boolean    @default(false) @map("auto_resolved") // закрыта, потому что ученик сам потом решил верно
  createdAt    DateTime   @default(now()) @map("created_at")
  resolvedAt   DateTime?  @map("resolved_at")

  @@unique([userId, taskId])
  @@index([status, createdAt])
  @@map("help_requests")
}

enum TestScope {
  topic
  section
  full
}

// Заменяет черновую TestAttempt: вопросы подбираются при старте и хранятся в самой попытке
model TestAttempt {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String    @map("subject_id")
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  scope       TestScope
  sectionId   String?   @map("section_id")
  topicId     String?   @map("topic_id")
  questionIds Json      @map("question_ids") // string[] в порядке показа
  answers     Json      @default("{}") // { [taskId]: "B" }
  startedAt   DateTime  @default(now()) @map("started_at")
  deadlineAt  DateTime? @map("deadline_at") // null — без таймера
  finishedAt  DateTime? @map("finished_at")
  score       Int?
  total       Int
  breakdown   Json? // [{ topicId, title, correct, total }]

  @@index([userId, subjectId, startedAt])
  @@map("test_attempts")
}

// ---------- Не используется с шага 5 (оставлено для справки) ----------
// model Test { scope TestScope; sectionId String?; topicId String? @unique; title String; timeLimitSeconds Int? }
// model TestQuestion { testId String; taskId String; order Int }
// Если понадобится редактируемый список тестов из админки — верните эти модели
// и параметры из TEST_CONFIG (src/lib/student/tests.ts) переедут в таблицу Test.
